# Store API derives its local Kubo/Cluster pools from this shared topology.
STORE_API_HOST=0.0.0.0
STORE_API_PORT=8003
STORAGE_BACKEND=ipfs_cluster
STORAGE_ENDPOINTS_FILE=/config/storage-endpoints.json
STORAGE_SITE_ID=site-a
IPFS_HEALTH_CACHE_TTL_SECONDS=10
REPLICATION_TARGET_REPLICAS=2
STORE_ADD_CONCURRENCY=4
STORE_STATUS_CONCURRENCY=6
STORE_PROMOTION_CONCURRENCY=4

# Filesystem is only used by unit tests.
FILESYSTEM_STORAGE_PATH=./storage
# Production default. Use DEBUG for detailed request/storage diagnostics.
LOG_LEVEL=WARNING
