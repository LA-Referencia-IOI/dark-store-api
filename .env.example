# =============================================================================
# dark-store-api Configuration
# =============================================================================
# This file can be used for standalone operation.
# For unified operation, variables are also defined in the root .env file.

# API server settings
STORE_API_HOST=0.0.0.0
STORE_API_PORT=8003

# Backend selection: "ipfs_cluster" (production) or "filesystem" (dev/test)
STORAGE_BACKEND=ipfs_cluster

# IPFS endpoints. Standalone defaults use localhost; integrated installs use ipfs0/cluster0.
IPFS_API_URL=http://localhost:5001
IPFS_CLUSTER_API_URL=http://localhost:9094
IPFS_CLUSTER_PROXY_API_URL=http://localhost:9095
IPFS_ADD_MODE=cluster_proxy
IPFS_HEALTH_CACHE_TTL_SECONDS=10
IPFS_CLUSTER_MIN_PEERS=2

# Filesystem backend path (only used when STORAGE_BACKEND=filesystem)
FILESYSTEM_STORAGE_PATH=./storage

# Logging
LOG_LEVEL=INFO
