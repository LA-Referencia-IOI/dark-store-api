# Store API runs once per application site and uses both local storage nodes.
STORE_API_HOST=0.0.0.0
STORE_API_PORT=8003
STORAGE_BACKEND=ipfs_cluster

IPFS_API_URLS_JSON=["http://10.200.1.11:5001","http://10.200.1.12:5001"]
IPFS_CLUSTER_API_URLS_JSON=["http://10.200.1.11:9094","http://10.200.1.12:9094"]
IPFS_CLUSTER_PROXY_API_URLS_JSON=["http://10.200.1.11:9095","http://10.200.1.12:9095"]
IPFS_CLUSTER_PEER_SITES_JSON={"site-a-storage-1":"site-a","site-a-storage-2":"site-a"}
IPFS_CLUSTER_LOCAL_SITE_ID=site-a
IPFS_REPLICATION_CONFIRM_TIMEOUT_SECONDS=120
IPFS_HEALTH_CACHE_TTL_SECONDS=10

# Filesystem is only used by unit tests.
FILESYSTEM_STORAGE_PATH=./storage
LOG_LEVEL=INFO
